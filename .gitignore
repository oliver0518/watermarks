# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/

# 运行时目录（由应用本身创建，勿提交）
uploads/
output/
logs/

# Coze 平台私有元数据（本地保留，不推到 GitHub）
.coze
.cozeproj/
.codegraph/
.preview/

# 系统文件
.DS_Store
Thumbs.db

# 编辑器
.idea/
.vscode/
*.swp
*.swo

# 环境配置
.env
.env.local

# 日志
*.log

# 构建产物（本地打包，不提交）
dist/
build/
*.spec
# 例外：PyInstaller 构建用的 spec 必须提交，否则 GitHub Actions checkout 后会找不到
!packaging/watermark-remover.spec
# 打包用临时 ffmpeg/ffprobe（从系统复制，仅供 PyInstaller 内嵌用）
/ffmpeg
/ffprobe

# PyInstaller 构建用的图标临时目录
packaging/icon-build/
